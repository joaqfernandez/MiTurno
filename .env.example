# =====================================================================================
# Plantilla de variables de entorno de MiTurno. NO poner valores reales en este archivo:
# está en Git y el repositorio es público. Los valores reales van solo en:
#   - apps/api-python/.env   (desarrollo local; ignorado por Git; lo crea `npm run setup:api`)
#   - el panel de secretos del proveedor de hosting (staging y producción)
# Si una clave real llega a Git por error, hay que revocarla en el proveedor y generar otra:
# borrarla del archivo no alcanza, queda en el historial.
#
# [obligatoria]      la API no arranca sin ella
# [prod]             obligatoria en producción (APP_ENV=production); ver app/config.py y tests/test_config.py
# [opcional]         solo si se usa ese proveedor
# =====================================================================================

# ---------------------------------------------------------------- API: apps/api-python/.env

# [obligatoria] development | production. Cualquier otro valor se rechaza al arrancar.
APP_ENV=development

# [obligatoria] PostgreSQL. En desarrollo, la base de Docker (docker-compose.yml, solo accesible desde esta máquina).
# En producción, la URL que da el proveedor de base gestionada.
DATABASE_URL=postgresql+psycopg://turnos:turnos_dev@127.0.0.1:55432/miturno_python

# [obligatoria] Firma de las sesiones: mínimo 32 bytes aleatorios. Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Distinta en cada entorno. Cambiarla cierra todas las sesiones.
JWT_ACCESS_SECRET=

# [prod] Cifrado de los tokens de Google guardados en la base: 64 caracteres hexadecimales (32 bytes). Mismo comando.
# No cambiarla en un entorno con datos: los tokens cifrados con la anterior dejan de poder leerse.
ENCRYPTION_KEY=

# [prod] Direcciones públicas; en producción deben ser https. Ejemplo:
#   WEB_URL=https://miturnosapp.com   API_URL=https://api.miturnosapp.com
WEB_URL=http://localhost:3001
API_URL=http://localhost:3000

# ---- Email (Resend) ----
# [prod] Sin email nadie puede confirmar su cuenta ni recuperar la contraseña.
# El remitente debe ser del dominio verificado en Resend, por ejemplo: MiTurno <no-reply@miturnosapp.com>
RESEND_API_KEY=
EMAIL_FROM=
# Solo desarrollo (prohibida en producción): carpeta donde se guardan los emails en lugar de enviarse.
# Vacía = apps/api-python/.data/mailbox.
DEV_MAILBOX_DIR=

# ---- Google (login y Google Calendar) [opcional] ----
# Credenciales OAuth de Google Cloud Console. En producción, los callbacks deben ser https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# ---- Mercado Pago (seña) [opcional] ----
# Desactivado en la beta (docs/BETA.md). Sin estas variables, un médico no puede exigir seña.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- Twilio (SMS) [opcional] ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------- Web: apps/web/.env.local
# Ninguna es secreta: las NEXT_PUBLIC_* quedan visibles en el navegador. Nunca poner claves en una NEXT_PUBLIC_*.

# Dónde está la API para el proxy /api de Next.js. Por defecto http://localhost:3000.
# API_URL=https://api.miturnosapp.com
# Solo si el navegador debe llamar a la API directamente (otro dominio). Vacía = usa el proxy /api.
# NEXT_PUBLIC_API_URL=
# Dirección pública de la web, para robots.txt y sitemap.xml. Por defecto http://localhost:3001.
# NEXT_PUBLIC_SITE_URL=https://miturnosapp.com
