# Referencia para apps/api-python/.env; npm run setup:api genera secretos locales.
DATABASE_URL=postgresql+psycopg://turnos:turnos_dev@127.0.0.1:55432/miturno_python
APP_ENV=development
JWT_ACCESS_SECRET=
# Clave de 32 bytes expresada como 64 caracteres hexadecimales.
ENCRYPTION_KEY=
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# Opcionales: necesarios para operar con estos proveedores.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==== Notificaciones ====
# Obligatorias en producción: sin email nadie puede confirmar su cuenta ni recuperar la contraseña.
RESEND_API_KEY=
EMAIL_FROM=
# Solo desarrollo (prohibida en producción): carpeta donde se escriben los emails. Por defecto apps/api-python/.data/mailbox.
DEV_MAILBOX_DIR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
